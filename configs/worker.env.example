# Variables d'environnement du binaire worker
#
# Généré à partir du code (internal/platform/config) : ne pas modifier à la
# main, lancer « make config-reference ». Les valeurs sont celles du
# développement local (make up) ; la documentation complète des clés est dans
# configs/reference.yaml.
#
# Utilisation :
#   set -a; . ./configs/worker.env.example; set +a     (shell, avant go run)
#   docker run --env-file configs/worker.env.example …
#   VS Code : "envFile" dans launch.json

# --- service

# Nom du service dans les journaux et les traces ; par défaut orders-api ou orders-worker
SERVICE_NAME=orders-worker

# --- http

# Adresse d'écoute ; par défaut :8080 (api) ou :8081 (worker)
HTTP_ADDRESS=:8081

# --- postgres

# URL de connexion (obligatoire) ; en production, par la variable d'environnement
POSTGRES_URL=postgres://skeleton:skeleton@localhost:5432/orders?sslmode=disable

# Taille maximale du pool de connexions
POSTGRES_MAX_CONNS=10

# Appliquer les migrations au démarrage (pratique en développement)
POSTGRES_AUTO_MIGRATE=true

# --- messaging

# Broker utilisé : nats ou redpanda
MESSAGING_BROKER=nats

# URL du serveur (plusieurs : séparées par des virgules)
MESSAGING_NATS_URL=nats://localhost:4222

# Adresses Kafka des brokers (hôte:port)
MESSAGING_REDPANDA_BROKERS=localhost:19092

# Partitions par topic créé : le parallélisme maximal d'un consommateur
MESSAGING_REDPANDA_PARTITIONS=3

# Copies de chaque partition : 1 en développement, 3 en production
MESSAGING_REDPANDA_REPLICATION_FACTOR=1

# --- consumer

# Au-delà de ce nombre de livraisons, un message en échec part en DLQ
CONSUMER_MAX_DELIVERIES=5

# Sans acquittement dans ce délai, le message est relivré
CONSUMER_ACK_WAIT=30s

# Essais rapides dans le processus, avant de rendre le message au broker
CONSUMER_RETRIES=3

# Délai avant le premier essai rapide (doublé ensuite)
CONSUMER_RETRY_INTERVAL=100ms

# Délai avant chaque relivraison ; le dernier s'applique ensuite
CONSUMER_BACKOFF=1s,5s,30s,2m

# --- log

# Niveau : debug, info, warn ou error
LOG_LEVEL=info

# Format : json (production) ou text (développement)
LOG_FORMAT=text

# --- telemetry

# Envoyer les traces au collecteur OpenTelemetry
TELEMETRY_ENABLED=true

# URL du collecteur, en OTLP HTTP
TELEMETRY_ENDPOINT=http://localhost:4318

# Part des nouvelles traces gardées, de 0 à 1 (une trace commencée ailleurs garde sa décision)
TELEMETRY_SAMPLE_RATIO=1

# --- shutdown

# Temps laissé aux traitements en cours, à l'arrêt
SHUTDOWN_TIMEOUT=15s
