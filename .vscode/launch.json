{
    // Lancement et débogage (extension Go, débogueur Delve).
    // « api + worker » démarre d'abord les dépendances (make up), puis les deux
    // applications, avec leur fichier de configuration.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "api",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/api",
            "args": ["-config", "configs/api.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "worker",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/worker",
            "args": ["-config", "configs/worker.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}"
        }
    ],
    "compounds": [
        {
            "name": "api + worker",
            "configurations": ["api", "worker"],
            "preLaunchTask": "dépendances : démarrer",
            "stopAll": true
        }
    ]
}
